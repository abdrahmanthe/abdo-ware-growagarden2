local function getPlayerList()
    local list = {"All Players"}
    for _, p in ipairs(playersService:GetPlayers()) do
        if p ~= localPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

local function packFloats(pos)
    local b = buffer.create(12)
    buffer.writef32(b, 0, pos.X)
    buffer.writef32(b, 4, pos.Y)
    buffer.writef32(b, 8, pos.Z)
    return buffer.tostring(b)
end

local function firePacket(payload)
    if typeof(payload) == "string" and #payload > 0 then
        pcall(function()
            packetEvent:FireServer(buffer.fromstring(payload))
        end)
    end
end

-- Robust Own Plot Finder
local function getOwnPlot()
    if state.cachedPlot and state.cachedPlot.Parent then return state.cachedPlot end
    
    for _, plot in ipairs(gardens:GetChildren()) do
        local ownerId = plot:GetAttribute("OwnerId")
        if ownerId and tostring(ownerId) == tostring(localPlayer.UserId) then
            state.cachedPlot = plot
            return plot
        end
    end
    
    local uid = tostring(localPlayer.UserId)
    for _, plot in ipairs(gardens:GetChildren()) do
        local pf = plot:FindFirstChild("Plants")
        if pf then
            for _, plant in ipairs(pf:GetChildren()) do
                if plant.Name:sub(1, #uid) == uid then
                    state.cachedPlot = plot
                    return plot
                end
            end
        end
    end

    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local best, bestDist = nil, math.huge
        for _, plot in ipairs(gardens:GetChildren()) do
            local spawn = plot:FindFirstChild("SpawnPoint")
            if spawn then
                local dist = (spawn.Position - hrp.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    best = plot
                end
            end
        end
        if best then
            state.cachedPlot = best
            return best
        end
    end
end

-- UNIVERSAL TELEPORT WRAPPER
local function checkAndTPToGarden()
    local myPlot = getOwnPlot()
    local plotSpawn = myPlot and myPlot:FindFirstChild("SpawnPoint")
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if plotSpawn and hrp then
        if (hrp.Position - plotSpawn.Position).Magnitude > 150 then
            firePacket(string.char(20, 0, 6) .. "Garden")
            task.wait(0.5) 
        end
    end
end

-- Filter Logic
local function isValidFruit(fruit)
    local sizeMulti = fruit:GetAttribute("SizeMulti")
    if sizeMulti then
        local kg = math.round(sizeMulti * 1000)
        if kg < state.minKg or kg > state.maxKg then
            return false
        end
    end
    
    local mut = fruit:GetAttribute("Mutation") or fruit:GetAttribute("MutationName") or fruit:GetAttribute("Mutated") or ""
    if typeof(mut) == "boolean" then mut = mut and "Mutated" or "" end
    local mutStr = string.lower(tostring(mut))
    
    if state.mutationMode == "Only Mutated" and mutStr == "" then return false end
    if state.mutationMode == "Ignore Mutated" and mutStr ~= "" then return false end
    
    if state.targetMutation ~= "" then
        if not string.find(mutStr, string.lower(state.targetMutation)) then return false end
    end
    
    return true
end

local function getFruitPosition(fruit)
    if fruit:IsA("BasePart") then return fruit.Position end
    local part = fruit.PrimaryPart or fruit:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or Vector3.zero
end

local function getMoney()
    local stats = localPlayer:FindFirstChild("leaderstats")
    if stats then
        local sheckles = stats:FindFirstChild("Sheckles") or stats:FindFirstChild("Money")
        if sheckles then return sheckles.Value end
    end
    return 0
end

local function isInventoryFull()
    local count = #localPlayer.Backpack:GetChildren()
    if localPlayer.Character then
        count = count + #localPlayer.Character:GetChildren()
    end
    return count >= state.maxInventoryItems
end

local function hasFruits()
    local function checkContainer(container)
        if not container then return false end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name
                if name ~= "Shovel" and name ~= "Build" and not string.find(name, "Watering Can") and not string.find(name, "Sprinkler") and not string.find(name, "Seed") then
                    if item:GetAttribute("SizeMulti") or item:GetAttribute("Weight") or item:GetAttribute("CorePartName") or string.find(name, "Fruit") then
                        return true
                    end
                end
            end
        end
        return false
    end
    if checkContainer(localPlayer.Backpack) then return true end
    if localPlayer.Character and checkContainer(localPlayer.Character) then return true end
    return false
end

local function flingCharacter(targetChar)
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    task.spawn(function()
        for i = 1, 10 do
            if hrp.Parent then
                hrp.Velocity = Vector3.new(0, 1e5, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(1e5, 1e5, 1e5)
            end
            task.wait(0.05)
        end
    end)
end

local function tweenCharacter(targetCFrame, customSpeed)
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = tonumber(customSpeed) or tonumber(state.tweenSpeed) or 150
    if speed < 10 then speed = 10 end
    local time = math.clamp(distance / speed, 0.15, 3.0)
    local tween = tweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    tween:Play()
    tween.Completed:Wait()
end

local function walkTo(targetPos, ownerChar)
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    
    hum.WalkSpeed = state.stealWalkSpeed
    hum:MoveTo(targetPos)
    
    local startTime = tick()
    local aborted = false
    
    while (hrp.Position - targetPos).Magnitude > 4 do
        if tick() - startTime > 4 then break end
        if not state.autoSteal then aborted = true break end
        
        if ownerChar then
            local oHrp = ownerChar:FindFirstChild("HumanoidRootPart")
            if oHrp and (oHrp.Position - hrp.Position).Magnitude <= state.dodgeRange then
                aborted = true
                break
            end
        end
        
        task.wait(0.1)
    end
    
    hum.WalkSpeed = 16
    return not aborted
end

local function columnToPositions(column)
    local positions = {}
    local cx, cy, cz = column.Position.X, column.Position.Y, column.Position.Z
    local sx, sz = column.Size.X, column.Size.Z
    local y = cy + 0.25
    local x = cx - sx / 2 + SPACING / 2
    while x <= cx + sx / 2 - SPACING / 2 + 0.01 do
        local z = cz - sz / 2 + SPACING / 2
        while z <= cz + sz / 2 - SPACING / 2 + 0.01 do
            table.insert(positions, Vector3.new(x, y, z))
            z = z + SPACING
        end
        x = x + SPACING
    end
    return positions
end

local function isOccupied(pos, plantsFolder, pending)
    for _, plant in ipairs(plantsFolder:GetChildren()) do
        local base = plant:FindFirstChildWhichIsA("BasePart", true)
        if base then
            local dx = base.Position.X - pos.X
            local dz = base.Position.Z - pos.Z
            if (dx * dx + dz * dz) < 9 then return true end
        end
    end
    for _, p in ipairs(pending) do
        local dx = p.X - pos.X
        local dz = p.Z - pos.Z
        if (dx * dx + dz * dz) < 9 then return true end
    end
    return false
end

local function nextSeed()
    for _, tool in ipairs(localPlayer.Backpack:GetChildren()) do
        if SEED_SET[tool.Name] then return tool end
    end
    local character = localPlayer.Character
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and SEED_SET[tool.Name] then return tool end
        end
    end
end

-- PROTECT LOGIC (Orbit & Hit)
local function performProtect()
    local myPlot = getOwnPlot()
    if not myPlot then return false end
    local plotSpawn = myPlot:FindFirstChild("SpawnPoint")
    local myHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not plotSpawn or not myHrp then return false end
    
    if (myHrp.Position - plotSpawn.Position).Magnitude > 60 then
        return false
    end

    local closestThief = nil
    local closestDist = math.huge

    for _, player in ipairs(playersService:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local eHrp = player.Character:FindFirstChild("HumanoidRootPart")
            local eHum = player.Character:FindFirstChildOfClass("Humanoid")
            if eHrp and eHum and eHum.Health > 0 then
                local dist = (eHrp.Position - plotSpawn.Position).Magnitude
                if dist <= 60 and dist < closestDist then
                    closestDist = dist
                    closestThief = player.Character
                end
            end
        end
    end

    if closestThief then
        local myChar = localPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myHum then return false end
        
        local shovel = myChar:FindFirstChild("Shovel") or localPlayer.Backpack:FindFirstChild("Shovel")
        if shovel and shovel.Parent == localPlayer.Backpack then
            myHum:EquipTool(shovel)
            task.wait(0.1)
            shovel = myChar:FindFirstChild("Shovel")
        end

        if shovel then
            local enemyHrp = closestThief:FindFirstChild("HumanoidRootPart")
            if not enemyHrp then return false end
            
            local orbitPos = enemyHrp.Position + (enemyHrp.CFrame.LookVector * 3) + (enemyHrp.CFrame.RightVector * 2)
            tweenCharacter(CFrame.new(orbitPos), state.protectTweenSpeed)
            
            if (myHrp.Position - enemyHrp.Position).Magnitude <= 7 then
                pcall(function() shovel:Activate() end)
            end
            
            return true
        end
    end
    return false
end

-- INSTANT HARVEST LOGIC
local function performHarvest(target)
    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Parent then
        local pos = getFruitPosition(target)
        if pos ~= Vector3.zero then
            local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if state.instantHarvest and hrp then
                -- Instant Snap
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                task.wait(0.05) -- Brief wait for server to accept distance
                pcall(function() fireproximityprompt(prompt) end)
                task.wait(0.05)
            else
                -- Normal Tween
                tweenCharacter(CFrame.new(pos + Vector3.new(0, 3, 0)))
                task.wait(tonumber(state.harvestDelay) or 0.1)
                pcall(function() fireproximityprompt(prompt) end)
                task.wait(tonumber(state.harvestDelay) or 0.1)
            end
            return true
        end
    end
    return false
end

local function performSellSequence()
    firePacket(string.char(20, 0, 4) .. "Sell")
    task.wait(tonumber(state.sellDelay) or 0.5) 
    state.lastSeq = (state.lastSeq + 1) % 128
    firePacket(string.char(17, 1, state.lastSeq))
    task.wait(tonumber(state.sellDelay) or 0.5)
    state.lastSeq = (state.lastSeq + 1) % 128
    firePacket(string.char(16, 1, state.lastSeq))
    task.wait(tonumber(state.sellDelay) or 0.5)
    state.lastSeq = (state.lastSeq + 1) % 128
    firePacket(string.char(15, 1, state.lastSeq))
    task.wait(1)
    checkAndTPToGarden()
end

local function performSteal()
    local isNight = lighting.ClockTime < 6 or lighting.ClockTime > 18
    if not isNight then return false end
    
    local myPlot = getOwnPlot()
    if not myPlot then return false end
    local plots = {}
    
    for _, plot in ipairs(gardens:GetChildren()) do
        if plot ~= myPlot and tostring(plot:GetAttribute("OwnerId")) ~= tostring(localPlayer.UserId) then
            local val = 0
            local hasValidFruit = false
            local pf = plot:FindFirstChild("Plants")
            if pf then
                for _, plant in ipairs(pf:GetChildren()) do
                    local ff = plant:FindFirstChild("Fruits")
                    if ff and #ff:GetChildren() > 0 then
                        for _, fruit in ipairs(ff:GetChildren()) do
                            if isValidFruit(fruit) then
                                val = val + (fruit:GetAttribute("SizeMulti") or 1)
                                hasValidFruit = true
                            end
                        end
                    else
                        if isValidFruit(plant) then
                            val = val + 1
                            hasValidFruit = true
                        end
                    end
                end
            end
            
            if hasValidFruit then
                local ownerId = plot:GetAttribute("OwnerId")
                local ownerPlayer = ownerId and playersService:GetPlayerByUserId(ownerId) or nil
                local isOwnerPresent = false
                
                if ownerPlayer and ownerPlayer.Character then
                    local spawn = plot:FindFirstChild("SpawnPoint")
                    if spawn then
                        local oHrp = ownerPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if oHrp and (oHrp.Position - spawn.Position).Magnitude <= 60 then
                            isOwnerPresent = true
                        end
                    end
                end

                table.insert(plots, { plot = plot, val = val, owner = ownerPlayer, ownerPresent = isOwnerPresent }) 
            end
        end
    end
    
    if state.stealTargetPlayer ~= "All Players" then
        for i = #plots, 1, -1 do
            local p = plots[i]
            if not p.owner or p.owner.Name ~= state.stealTargetPlayer then
                table.remove(plots, i)
            end
        end
    end
    
    local ignorePresence = string.find(state.stealSortMethod, "No Owner") ~= nil
    if ignorePresence then
        for i = #plots, 1, -1 do
            if plots[i].ownerPresent then table.remove(plots, i) end
        end
    end
    
    table.sort(plots, function(a, b) 
        if string.find(state.stealSortMethod, "Least") then return a.val < b.val
        else return a.val > b.val end
    end)
    
    for _, data in ipairs(plots) do
        local bestPlot = data.plot
        checkAndTPToGarden() 
        
        if data.ownerPresent and data.owner and state.flingOwner then
            local spawn = bestPlot:FindFirstChild("SpawnPoint")
            local timeout = 5
            local startTime = tick()
            
            while tick() - startTime < timeout do
                if not state.autoSteal then break end
                if not data.owner.Character then break end
                local currentHrp = data.owner.Character:FindFirstChild("HumanoidRootPart")
                if not currentHrp or not spawn or (currentHrp.Position - spawn.Position).Magnitude > 60 then break end
                flingCharacter(data.owner.Character)
                task.wait(0.5)
            end
        end
        
        local pf = bestPlot:FindFirstChild("Plants")
        if pf then
            local validTargets = {}
            for _, plant in ipairs(pf:GetChildren()) do
                local ff = plant:FindFirstChild("Fruits")
                if ff and #ff:GetChildren() > 0 then
                    for _, fruit in ipairs(ff:GetChildren()) do
                        if isValidFruit(fruit) then
                            table.insert(validTargets, { 
                                target = fruit, 
                                value = fruit:GetAttribute("SizeMulti") or 0 
                            })
                        end
                    end
                else
                    if isValidFruit(plant) then
                        table.insert(validTargets, { 
                            target = plant, 
                            value = plant:GetAttribute("SizeMulti") or 0 
                        })
                    end
                end
            end
            
            table.sort(validTargets, function(a, b) return a.value > b.value end)
            
            for _, item in ipairs(validTargets) do
                if not state.autoSteal then break end
                local targetFruit = item.target
                local targetPos = getFruitPosition(targetFruit)
                local ownerChar = data.owner and data.owner.Character or nil
                
                if state.instantHarvest then
                    local myHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myHrp then
                        myHrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                        task.wait(0.05)
                        local prompt = targetFruit:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then pcall(function() fireproximityprompt(prompt) end) end
                        task.wait(0.05)
                    end
                else
                    local success = walkTo(targetPos, ownerChar)
                    
                    if success then
                        local prompt = targetFruit:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            task.wait(tonumber(state.harvestDelay) or 0.1)
                            pcall(function() fireproximityprompt(prompt) end)
                            task.wait(tonumber(state.harvestDelay) or 0.1)
                        end
                    else
                        warn("[GaG2] Owner came too close! Dodging...")
                        break
                    end
                end
            end
        end
        
        checkAndTPToGarden()
        return true
    end
    return false
end

-- THE SCHEDULER
task.spawn(function()
    while not state.isUnloaded do
        task.wait(0.05)
        local didAction = false
        local invFull = isInventoryFull()
        
        local anyToggled = state.autoHarvest or state.autoSteal or state.autoSell or state.autoBuy or state.autoPlant or state.autoProtect or state.autoExpand
        if not anyToggled then
            task.wait(0.5)
            continue
        end
        
        if state.autoProtect and not didAction then
            local protected = performProtect()
            if protected then
                didAction = true
                continue
            end
        end
        
        if invFull then
            if state.autoSell then
                warn("[GaG2] Inventory full & Auto Sell ON. Selling items...")
                performSellSequence()
                state.harvestedCount = 0
                didAction = true
                task.wait(1)
            else
                if not shared.invFullWarned then
                    warn("[GaG2] Inventory full & Auto Sell OFF. Pausing actions.")
                    shared.invFullWarned = true
                end
                task.wait(1)
            end
            continue 
        else
            shared.invFullWarned = false
        end

        if state.autoSteal and not didAction then
            local success = performSteal()
            if success then didAction = true end
        end

        if state.autoHarvest and not didAction then
            local myPlot = getOwnPlot()
            if myPlot then
                local pf = myPlot:FindFirstChild("Plants")
                if pf then
                    local validTargets = {}
                    for _, plant in ipairs(pf:GetChildren()) do
                        local ff = plant:FindFirstChild("Fruits")
                        if ff and #ff:GetChildren() > 0 then
                            for _, fruit in ipairs(ff:GetChildren()) do
                                if isValidFruit(fruit) then
                                    table.insert(validTargets, { 
                                        target = fruit, 
                                        value = fruit:GetAttribute("SizeMulti") or 0 
                                    })
                                end
                            end
                        else
                            if isValidFruit(plant) then
                                table.insert(validTargets, { 
                                    target = plant, 
                                    value = plant:GetAttribute("SizeMulti") or 0 
                                })
                            end
                        end
                    end
                    
                    table.sort(validTargets, function(a, b) return a.value > b.value end)
                    
                    if #validTargets > 0 then
                        local targetFruit = validTargets[1].target
                        didAction = performHarvest(targetFruit)
                        if didAction then 
                            state.harvestedCount = state.harvestedCount + 1
                        end
                    end
                end
            end
        end

        if state.autoSellAfterHarvest and not didAction then
            if state.harvestedCount >= state.sellThreshold then
                if hasFruits() then
                    performSellSequence()
                    state.harvestedCount = 0
                    didAction = true
                else
                    state.harvestedCount = 0 
                end
            end
        end

        if state.autoPlant and not didAction then
            local plot = getOwnPlot()
            if plot then
                local visual = plot:FindFirstChild("Visual")
                local pf = plot:FindFirstChild("Plants")
                if visual and pf then
                    local columns = { visual:FindFirstChild("PlantAreaColumn1"), visual:FindFirstChild("PlantAreaColumn2") }
                    local plantedThisTick = false
                    
                    for _, col in ipairs(columns) do
                        if col then
                            local positions = columnToPositions(col)
                            for _, pos in ipairs(positions) do
                                if not isOccupied(pos, pf, {}) then
                                    local tool = nextSeed()
                                    if tool then
                                        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                                        local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
                                        if hrp and hum then
                                            checkAndTPToGarden()
                                            tweenCharacter(CFrame.new(pos.X, pos.Y + 3, pos.Z))
                                            task.wait(tonumber(state.plantDelay) or 0.3)
                                            
                                            if tool.Parent == localPlayer.Backpack then 
                                                hum:EquipTool(tool) 
                                            end
                                            
                                            task.wait(0.2)
                                            local eq = localPlayer.Character:FindFirstChild(tool.Name)
                                            
                                            if eq and eq:IsA("Tool") then
                                                local payload = "\x24\x00" .. packFloats(pos) .. string.char(#eq.Name) .. eq.Name
                                                pcall(function() 
                                                    packetEvent:FireServer(buffer.fromstring(payload), { eq }) 
                                                end)
                                                task.wait(tonumber(state.plantDelay) or 0.3)
                                                hum:UnequipTools()
                                                didAction = true
                                                plantedThisTick = true
                                                state.isPlanting = true
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        if plantedThisTick then break end
                    end
                    
                    if not plantedThisTick and state.isPlanting then
                        state.isPlanting = false
                        local spawn = plot:FindFirstChild("SpawnPoint")
                        if spawn then
                            tweenCharacter(spawn.CFrame + Vector3.new(0, 3, 0))
                            didAction = true
                        end
                    end
                end
            end
        end

        if state.autoSell and not didAction then
            if hasFruits() then
                performSellSequence()
                didAction = true
                state.harvestedCount = 0
            end
        end

        if state.autoBuy and not didAction then
            for name, selected in pairs(state.buyTargets) do
                if selected then
                    local price = SEED_PRICES[name] or 0
                    if getMoney() >= price then
                        firePacket(string.char(184, 0, #name) .. name)
                        task.wait(tonumber(state.buyDelay) or 0.15)
                        didAction = true
                        break 
                    end
                end
            end
        end

        if state.autoExpand and not didAction then
            firePacket(string.char(66, 1, 45))
            task.wait(1)
            didAction = true
        end
        
        if not didAction then task.wait(0.5) end
    end
end)

